# docker-compose.dev.yml — DÉVELOPPEMENT LOCAL de {{ project_name }} ({{ gitsky_tier }}).
#
# Objectif : `docker compose -f docker-compose.dev.yml up` et l'app tourne — sans
# Traefik, sans domaine, sans PostgreSQL. La PRODUCTION reste docker-compose.yml
# (images buildées, réseau proxy-net, TLS Let's Encrypt) ; ce fichier-ci n'existe
# que pour lancer et tester le projet en local, y compris par un tiers qui clone
# le dépôt.
#
# Deux différences clés avec la prod, toutes deux au service de la simplicité
# locale :
#   - base SQLite (aucun service Postgres à démarrer, quel que soit le tier) ;
#   - code source monté en volume -> hot-reload backend (uvicorn --reload) et
#     frontend (Vite HMR), sans rebuild à chaque édition.
#
# Ne pas éditer à la main : modifier le template du générateur.
services:
  backend:
    build:
      context: .
      dockerfile: Dockerfile.dev
    container_name: {{ project_name }}_backend_dev
    command: uvicorn app.core.main:app --host 0.0.0.0 --port 8000 --reload
    environment:
      # SQLite local dans /data (seul dossier inscriptible, cf. Dockerfile). La
      # prod bascule sur Postgres via son propre compose (T1/T2).
      - DATABASE_URL=sqlite+aiosqlite:////data/gitsky.db
      - SECRET_KEY=dev-insecure-change-me-in-production-0123456789
      - ENVIRONMENT=development
      # Origine publique locale (sitemap.xml / robots.txt, Chap 10).
      - SITE_URL=http://localhost:5173
    ports:
      - "8000:8000"
    volumes:
      # Le code de l'hôte monté par-dessus l'image : uvicorn --reload voit les
      # éditions. Les dépendances vivent dans site-packages, pas dans /app, donc
      # ce montage ne les masque pas.
      - .:/app
      # /data hors du montage source, pour que le SQLite survive au reload.
      - backend_data:/data

  frontend:
    build:
      context: ./frontend
      dockerfile: Dockerfile.dev
    container_name: {{ project_name }}_frontend_dev
    environment:
      # Le navigateur tourne sur l'HÔTE : il joint le backend via le port publié
      # localhost:8000 (et non le nom de service Docker, inconnu du navigateur).
      - VITE_API_URL=http://localhost:8000
    ports:
      - "5173:5173"
    volumes:
      # Montage du code pour le HMR ; volume anonyme pour garder le node_modules
      # installé dans l'image (sinon le montage de l'hôte, sans node_modules, le
      # masquerait).
      - ./frontend:/app
      - /app/node_modules
    depends_on:
      - backend

volumes:
  backend_data:
