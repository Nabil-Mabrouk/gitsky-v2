# .env.backup — configuration des scripts de maintenance (Chap 23).
# Copier ce fichier en .env.backup et l'ajuster. NE JAMAIS committer .env.backup
# (il peut porter S3_BUCKET / ALERT_EMAIL). Les scripts lisent .env.backup.
{% if gitsky_tier == "t0" -%}
#
# ⚠️ {{ project_name }} est un projet T0 (landing sans base propre, Chap 18 §3) :
# les leads vont au collecteur partagé, il n'y a pas de PostgreSQL à sauvegarder.
# Ces valeurs ne servent que si le projet est promu en T1/T2.
{% endif -%}
POSTGRES_CONTAINER={{ project_name }}_db
POSTGRES_DB={{ db_name }}
POSTGRES_USER={{ db_name }}
BACKUP_DIR=/backups/postgres
BACKUP_RETENTION=14

# Traefik est un service partagé de la flotte (Chap 18), pas scopé au projet.
TRAEFIK_CONTAINER=traefik

# Hors-site (règle 3-2-1) et alertes — décommenter si disponibles.
# S3_BUCKET=mystudio-backups
# ALERT_EMAIL=admin@mystudio.com
