GITSKY_TIER={{ gitsky_tier }}
PROJECT_NAME={{ project_name }}
# Workers Gunicorn en production (Chap 21), lu nativement par Gunicorn. C'est la
# seule chose qui varie par tier au déploiement : promouvoir T1 -> T2 = changer
# cette valeur et redéployer, sans rebuild d'image.
WEB_CONCURRENCY={{ gunicorn_workers }}
# Clé de signature JWT (Chap 7). Générée par projet ; la faire tourner tous les
# 6 mois (calendrier de rotation, Chap 23 §2.2).
SECRET_KEY={{ secret_key }}
{%- if gitsky_tier != "t0" %}
# PostgreSQL du projet (T1/T2). Compose crée cette base au premier démarrage et
# substitue ces valeurs dans docker-compose.yml. Mot de passe généré par projet.
POSTGRES_USER={{ db_name }}
POSTGRES_PASSWORD={{ postgres_password }}
POSTGRES_DB={{ db_name }}
{%- endif %}
{% for flag, value in resolved_modules.items() -%}
{{ flag | upper }}={{ value | string | lower }}
{% endfor -%}
