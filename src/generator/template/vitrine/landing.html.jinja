<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ project_name }}</title>
    <style>
      :root {
        --primary: {{ branding.primary_color }};
        --on-primary: {{ branding.primary_foreground }};
        --font: "{{ branding.font_family }}", system-ui, sans-serif;
      }
      body { font-family: var(--font); margin: 0; color: #111; }
      .hero { padding: 5rem 1.5rem; text-align: center; }
      .hero h1 { font-size: 2.5rem; margin: 0 0 1rem; }
      .capture { text-align: center; padding: 2rem 1.5rem; }
      .btn {
        background: var(--primary); color: var(--on-primary);
        padding: 0.75rem 1.25rem; border: none; border-radius: 0.5rem;
        font: inherit; cursor: pointer;
      }
    </style>
  </head>
  <body>
    {% for block in landing.blocks -%}
    {% if block.type == "hero" %}
    <section class="hero">
      <h1>{{ block.headline }}</h1>
      <p>{{ block.subhead }}</p>
    </section>
    {% elif block.type == "email_capture" %}
    <section class="capture">
      <form data-project="{{ project_name }}">
        <input type="email" placeholder="votre@email.com" required />
        <button class="btn" type="submit">{{ block.cta }}</button>
      </form>
    </section>
    {% endif %}
    {%- endfor %}
  </body>
</html>
