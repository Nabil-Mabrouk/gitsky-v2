# Contexte de build du frontend (Chap 21).

node_modules
dist
.git

# .env porte l'URL d'API du DÉVELOPPEMENT (localhost). Vite inlinant les VITE_*
# au build, le laisser entrer dans le contexte reviendrait à risquer un bundle
# de production pointant sur localhost. L'URL réelle arrive par --build-arg.
.env
.env.*
!.env.example
