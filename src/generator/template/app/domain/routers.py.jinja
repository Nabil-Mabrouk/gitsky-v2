from fastapi import APIRouter

{% for route in domain_routers %}
{{ route.name }}_router = APIRouter(prefix="{{ route.prefix }}", tags=["{{ route.name }}"])


@{{ route.name }}_router.get("")
async def list_{{ route.name }}() -> dict:
    return {"router": "{{ route.name }}", "status": "scaffolded"}

{% endfor %}
