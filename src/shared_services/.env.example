# Secrets d'infra pour shared_services/docker-compose.yml (Chap 18/22).
# Copier en .env (hors VCS, voir .gitignore) et renseigner chaque valeur.

# Email de contact pour les certificats Let's Encrypt (obligatoire, ACME l'exige).
ACME_EMAIL=

# Mot de passe du compte postgres root du VPS (crée les DB des services partagés).
POSTGRES_ROOT_PASSWORD=

# Mot de passe du rôle "landing" utilisé par le landing-collector.
LANDING_DB_PASSWORD=

# Clé API Anthropic consommée par le llm-proxy (litellm) pour tous les projets de la flotte.
ANTHROPIC_API_KEY=

# Clé API OpenAI, utilisée uniquement par le modèle gpt-image-2 du llm-proxy
# (génération d'image hero, Chap 24 Round B). Laisser vide si aucun projet
# n'utilise la génération d'image Studio — seul cet appel-là échouerait,
# les modèles Anthropic (litellm-config.yaml) restent fonctionnels sans elle.
OPENAI_API_KEY=

# Clé maître litellm — ADMINISTRATION du proxy uniquement (création des jetons
# projet, Studio du fleet dashboard). Ne JAMAIS la donner à un projet : chaque
# projet reçoit son propre jeton budgété via scripts/llm-proxy-keys.sh create-key.
LITELLM_MASTER_KEY=

# Mot de passe du rôle postgres "litellm" (base des jetons/budgets/spend logs
# du llm-proxy). Généré par scripts/llm-proxy-keys.sh init-db si vide.
LITELLM_DB_PASSWORD=

# Clé API Groq (modèles groq-* de litellm-config.yaml). À poser à la main par
# l'opérateur, en SSH, directement dans ce fichier — jamais via un dépôt
# projet, un agent de développement ou un chat. Vide = seuls les modèles
# groq-* échouent, le reste du proxy fonctionne.
GROQ_API_KEY=

# Clé API DeepSeek (modèles deepseek-* de litellm-config.yaml). Même règle que
# GROQ_API_KEY : posée à la main par l'opérateur, jamais via un dépôt/agent/chat.
DEEPSEEK_API_KEY=

# Jeton exigé (header X-Collector-Token) pour lire les stats/leads du landing
# collector (GET /leads/{project}/stats, GET /leads/{project}) — la capture
# POST /leads reste publique sans token. Même valeur que COLLECTOR_STATS_TOKEN
# dans le .env du fleet dashboard (Chap 18, Chap 19 onglet Leads) : les deux
# DOIVENT être identiques, sinon le dashboard reçoit 401 du collector.
COLLECTOR_STATS_TOKEN=

# Relais SMTP pour le double opt-in du landing collector (Chap 18) — mêmes
# noms de variable que app/core/mailer.py, mais namespace de fichier séparé
# (ce .env, pas celui d'un projet) donc pas de collision.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Copie HORS SERVEUR des sauvegardes (backup-fleet.sh) : nom d'un remote rclone
# configuré sur le VPS, idéalement CHIFFRÉ (type crypt), suivi d'un dossier —
# ex. gitsky-crypt:fleet. Vide = aucune copie ne quitte le serveur (/backups
# est sur le même disque que les données : la perte du VPS emporterait tout).
BACKUP_RCLONE_REMOTE=

# Umami, mesure d'audience de la flotte (Chap 13/18 §8). UMAMI_HOST = son
# sous-domaine public (ex. stats.0-hitl.com, enregistrement DNS A vers le VPS).
# UMAMI_DB_PASSWORD / UMAMI_APP_SECRET : générés par scripts/umami-setup.sh
# init si vides — APP_SECRET ne doit plus changer ensuite.
UMAMI_HOST=
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=
