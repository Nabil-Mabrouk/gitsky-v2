# Secrets d'infra pour shared_services/docker-compose.yml (Chap 18/22).
# Copier en .env (hors VCS, voir .gitignore) et renseigner chaque valeur.

# Email de contact pour les certificats Let's Encrypt (obligatoire, ACME l'exige).
ACME_EMAIL=

# Mot de passe du compte postgres root du VPS (crée les DB des services partagés).
POSTGRES_ROOT_PASSWORD=

# Mot de passe du rôle "landing" utilisé par le landing-collector.
LANDING_DB_PASSWORD=

# Clé API Anthropic consommée par le llm-proxy (litellm) pour tous les projets de la flotte.
ANTHROPIC_API_KEY=

# Clé maître litellm — authentifie les projets qui appellent le llm-proxy interne.
LITELLM_MASTER_KEY=
