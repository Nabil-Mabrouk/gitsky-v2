# Secrets d'infra pour shared_services/docker-compose.yml (Chap 18/22).
# Copier en .env (hors VCS, voir .gitignore) et renseigner chaque valeur.

# Email de contact pour les certificats Let's Encrypt (obligatoire, ACME l'exige).
ACME_EMAIL=

# Mot de passe du compte postgres root du VPS (crée les DB des services partagés).
POSTGRES_ROOT_PASSWORD=

# Mot de passe du rôle "landing" utilisé par le landing-collector.
LANDING_DB_PASSWORD=

# Clé API Anthropic consommée par le llm-proxy (litellm) pour tous les projets de la flotte.
ANTHROPIC_API_KEY=

# Clé API OpenAI, utilisée uniquement par le modèle gpt-image-2 du llm-proxy
# (génération d'image hero, Chap 24 Round B). Laisser vide si aucun projet
# n'utilise la génération d'image Studio — seul cet appel-là échouerait,
# les modèles Anthropic (litellm-config.yaml) restent fonctionnels sans elle.
OPENAI_API_KEY=

# Clé maître litellm — authentifie les projets qui appellent le llm-proxy interne.
LITELLM_MASTER_KEY=

# Jeton exigé (header X-Collector-Token) pour lire les stats/leads du landing
# collector (GET /leads/{project}/stats, GET /leads/{project}) — la capture
# POST /leads reste publique sans token. Même valeur que COLLECTOR_STATS_TOKEN
# dans le .env du fleet dashboard (Chap 18, Chap 19 onglet Leads) : les deux
# DOIVENT être identiques, sinon le dashboard reçoit 401 du collector.
COLLECTOR_STATS_TOKEN=

# Relais SMTP pour le double opt-in du landing collector (Chap 18) — mêmes
# noms de variable que app/core/mailer.py, mais namespace de fichier séparé
# (ce .env, pas celui d'un projet) donc pas de collision.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
