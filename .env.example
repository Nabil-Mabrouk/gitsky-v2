# Spike GitSky — copier en .env et ajuster le tier.
# T0 (Landing) : aucun module. T1 (MVP) : auth+analytics+security.
# T2 (SaaS)    : tous les modules du spike.
GITSKY_TIER=t0
PROJECT_NAME=gitsky-spike

# Surcharge individuelle possible (gagne toujours sur le profil de tier) :
# MODULE_ANALYTICS=true
